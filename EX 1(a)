class Employee {
    int empID;
    String name;
    double salary;
    Employee(int empID, String name, double salary) {
        this.empID = empID;
        this.name = name;
        this.salary = salary;
    }

    void display() {
        System.out.println("Employee ID: " + empID);
        System.out.println("Name: " + name);
        System.out.println("Salary: " + salary);
    }
}

public class EmployeeDemo {
    public static void main(String[] args) {
        Employee e1 = new Employee(89,"saranya", 45000.0);
        e1.display();
    }
}


OUTPUT
Employee ID: 89
Name: saranya
Salary: 45000.0
